OPENROUTER_API_KEY=
E2B_API_KEY=
AGENT_MODEL=anthropic/claude-haiku-4.5
# Prompt-based model routing via OpenRouter Jev Router. Set empty to always use AGENT_MODEL.
MODEL_ROUTER=typesafe/jev-router
LLM_PROVIDER=mock
SANDBOX_PROVIDER=local
DEMO_KEY=
MAX_CONCURRENT_RUNS=3
SPEND_FILE=./data/spend.json
# Seconds the scripted mock provider pauses per turn so demos read naturally (0 in tests).
MOCK_TURN_DELAY_S=0
