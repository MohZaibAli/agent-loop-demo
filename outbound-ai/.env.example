# mock (default, free) | retell. Real SMS/calls are ONLY made with SERVICE_PROVIDER=retell
# AND a valid X-Demo-Key header. Everything else falls back to mock.
SERVICE_PROVIDER=mock
DEMO_KEY=

# Retell AI
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=+10000000000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000

# Google Sheets. SHEETS_PROVIDER=fixture reads/writes fixtures/leads.json (in memory).
# SHEETS_PROVIDER=google uses a service account (JSON string or path) and the sheet id.
SHEETS_PROVIDER=fixture
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Sheet1

# Wait between the SMS and the call. Default 600s; mock/tests use WAIT_SECONDS_MOCK.
WAIT_SECONDS=600
WAIT_SECONDS_MOCK=5

SPEND_FILE=./data/spend.json
PORT=8000
